# Connection string do banco Postgres (Neon)
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"

# Chave da API do Gemini, usada para gerar o roteiro (texto) das cenas
# (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="sua-chave-aqui"

# Credenciais da Cloudflare Workers AI, usadas para gerar a ilustração das
# cenas com o modelo gratuito flux-1-schnell (10.000 "neurons" grátis por dia,
# sem cartão — ver src/lib/image-gen.ts). Crie uma conta em
# https://dash.cloudflare.com, pegue o Account ID (aparece na URL do
# dashboard ou na barra lateral direita de qualquer domínio/Workers) e gere
# um API Token em "My Profile > API Tokens > Create Token" com permissão
# "Workers AI - Read".
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Vercel Blob: em produção (rodando na Vercel), a autenticação é automática via
# OIDC assim que o Blob store estiver conectado ao projeto (BLOB_STORE_ID e
# VERCEL_OIDC_TOKEN são injetados sozinhos — não precisa colar nada aqui).
# Só preencha BLOB_READ_WRITE_TOKEN se for rodar fora da Vercel (ex: local sem
# `vercel env pull`), pegando o valor em Storage > seu Blob store > .env.local.
BLOB_READ_WRITE_TOKEN=""

# Credenciais do Inngest (obrigatórias em produção; em dev local o
# `npx inngest-cli dev` funciona sem elas)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
