# Connection string do banco Postgres (Neon)
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"

# Chave da API do Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="sua-chave-aqui"

# Token do Vercel Blob (criado automaticamente ao conectar um Blob store
# ao projeto na Vercel; para rodar localmente, pegue em
# Vercel Dashboard > Storage > seu Blob store > .env.local)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Credenciais do Inngest (obrigatórias em produção; em dev local o
# `npx inngest-cli dev` funciona sem elas)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
