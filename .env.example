# Connection string do banco Postgres (Neon)
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"

# Chave da API do Gemini, usada para gerar o roteiro (texto) das cenas
# (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="sua-chave-aqui"

# Credenciais da Cloudflare Workers AI, usadas para gerar a ilustração das
# cenas com o modelo gratuito flux-1-schnell (10.000 "neurons" grátis por dia,
# sem cartão — ver src/lib/image-gen.ts). Crie uma conta em
# https://dash.cloudflare.com, pegue o Account ID (aparece na URL do
# dashboard ou na barra lateral direita de qualquer domínio/Workers) e gere
# um API Token em "My Profile > API Tokens > Create Token" com permissão
# "Workers AI - Read".
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Cloudflare R2: armazena áudio/imagens/vídeo final gerados (ver storage.ts).
# Usa a MESMA conta Cloudflare do CLOUDFLARE_ACCOUNT_ID acima (Workers AI),
# mas precisa de credenciais próprias, específicas do R2:
# 1. https://dash.cloudflare.com > R2 Object Storage > Create bucket
#    (10GB grátis, sem cartão). Anote o nome em R2_BUCKET_NAME.
# 2. No bucket criado > Settings > Public access > "Allow Access" (ativa o
#    subdomínio público pub-xxxxx.r2.dev). Cole a URL SEM barra no final em
#    R2_PUBLIC_URL.
# 3. R2 > Manage API Tokens > Create API Token > permissão "Object Read &
#    Write", restrito a esse bucket. Cole Access Key ID / Secret Access Key
#    abaixo.
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Credenciais do Inngest (obrigatórias em produção; em dev local o
# `npx inngest-cli dev` funciona sem elas)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Chave gratuita da Pexels API, usada para buscar vídeos reais de banco para
# até 3 cenas do roteiro (ex: "trabalhador colocando capacete de segurança").
# Sem essa chave, todas as cenas voltam a usar imagem estática (Ken Burns).
# (https://www.pexels.com/api/)
PEXELS_API_KEY=""
